    "src/shared/ui/chart.tsx",
    "src/shared/ui/dropdown-menu.tsx",
    "src/shared/ui/textarea.tsx",
    "src/shared/ui/tooltip.tsx",
    "src/shared/ui/animated-modal.tsx",
    "src/shared/ui/background-beams.tsx"
  ]
}
